# InternPath AI — Environment Configuration (Phase 3.2)
#
# Production PostgreSQL Connection:
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/internpath_dev
#
# Local Development / Test Default (Zero-config SQLite fallback):
DATABASE_URL=sqlite:///./internpath.db

# Path to compiled C++20 DSA executable
INTERNPATH_DSA_BIN=../../build/engine/Release/internpath_dsa.exe

# Single-user local development mode (explicitly prevents public deployment)
DEV_MODE=true
DEV_STUDENT_EMAIL=student@internpath.local

# Phase 3.4 Agentic AI LLM Configuration (Optional)
# Supported providers: deterministic (default), mock, gemini, openai
INTERNPATH_LLM_PROVIDER=deterministic
INTERNPATH_LLM_MODEL=gemini-1.5-flash
# Optional API keys:
# GEMINI_API_KEY=
# OPENAI_API_KEY=

